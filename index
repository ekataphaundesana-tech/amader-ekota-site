<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>আমাদের একতা ফাউন্ডেশন</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,"Noto Sans Bengali",sans-serif;
  background:#f4fff8;
  color:#123c30;
  line-height:1.7;
}

/* HEADER */
header{
  background:#123c30;
  padding:12px 18px;
  position:sticky;
  top:0;
  z-index:1000;
}

.nav{
  max-width:1150px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  color:white;
  font-size:21px;
  font-weight:bold;
}

.logo img{
  width:58px;
  height:58px;
  border-radius:50%;
  object-fit:cover;
  border:3px solid #08b653;
}

nav a{
  color:white;
  text-decoration:none;
  margin-left:18px;
  font-size:16px;
}

nav a:hover{
  color:#55e58d;
}

/* HERO */
.hero{
  padding:65px 20px;
  text-align:center;
  background:linear-gradient(135deg,#e8fff1,#ffffff);
}

.hero h1{
  font-size:42px;
  color:#123c30;
  margin-bottom:12px;
}

.hero h3{
  color:#08b653;
  font-size:24px;
  margin-bottom:12px;
}

.hero p{
  max-width:750px;
  margin:auto;
  font-size:18px;
}

.hero img{
  width:100%;
  max-width:900px;
  height:360px;
  object-fit:cover;
  border-radius:20px;
  margin-top:30px;
  box-shadow:0 8px 25px #0002;
}

.btn{
  display:inline-block;
  background:#08b653;
  color:white;
  text-decoration:none;
  padding:12px 24px;
  border-radius:8px;
  margin:18px 5px 0;
  font-weight:bold;
}

.btn:hover{
  background:#067e3b;
}

/* COMMON */
section{
  padding:60px 20px;
}

.container{
  max-width:1150px;
  margin:auto;
}

h2{
  text-align:center;
  font-size:32px;
  color:#123c30;
  margin-bottom:35px;
}

.text{
  max-width:850px;
  margin:auto;
  text-align:center;
  font-size:18px;
}

/* PROGRAMS */
.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:22px;
}

.card{
  background:white;
  border-radius:15px;
  padding:18px;
  box-shadow:0 4px 15px #0002;
  transition:.3s;
}

.card:hover{
  transform:translateY(-5px);
}

.card img{
  width:100%;
  height:190px;
  object-fit:cover;
  border-radius:12px;
}

.card h3{
  color:#08a64e;
  margin:12px 0 5px;
  font-size:21px;
}

